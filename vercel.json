{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin.html", "dest": "/admin-page.html" },
    { "src": "/api/blob/token", "dest": "/api/blob/token.js" },
    { "src": "/api/album/upload", "dest": "/api/album/upload.js" },
    { "src": "/api/album/([a-zA-Z0-9_-]+)", "dest": "/api/album/[id].js?id=$1" },
    { "src": "/api/album", "dest": "/api/album.js" },
    { "src": "/album/([a-zA-Z0-9_-]+)", "dest": "/album.html?id=$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}