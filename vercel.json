{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "css/**/*.css", "use": "@vercel/static" },
    { "src": "js/**/*.js", "use": "@vercel/static" },
    { "src": "photos/**/*", "use": "@vercel/static" },
    { "src": "music/**/*", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.jpeg", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin.html", "dest": "/admin-page.html" },
    { "src": "/api/blob/token", "dest": "/api/blob/token.js" },
    { "src": "/api/auth/login", "dest": "/api/auth/auth.js" },
    { "src": "/api/auth/register", "dest": "/api/auth/register.js" },
    { "src": "/api/auth/logout", "dest": "/api/auth/auth.js" },
    { "src": "/api/auth/me", "dest": "/api/auth/me.js" },
    { "src": "/api/album/upload", "dest": "/api/album/upload.js" },
    { "src": "/api/album/([a-zA-Z0-9_-]+)", "dest": "/api/album/[id].js?id=$1" },
    { "src": "/api/album", "dest": "/api/album.js" },
    { "src": "/api/photos", "dest": "/api/photos.js" },
    { "src": "/api/music", "dest": "/api/music.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/albums", "dest": "/api/albums.js" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/album/([a-zA-Z0-9_-]+)", "dest": "/album.html?id=$1" }
  ]
}